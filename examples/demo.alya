## gui foundation showcase (headless-safe: no windows are opened)
## Part of the Alya Language package ecosystem (https://github.com/alya-lang)

import "../src/lib.alya" as pkg

function main()
    say "=== gui Foundation Showcase ==="
    say ""

    say "--- Backend ---"
    let info = pkg::backend_details()
    say "Backend: " + info.backend
    say "OS:      " + info.os
    say "Display: " + info.display
    say ""

    say "--- Geometry ---"
    let a = pkg::rect(10, 10, 100, 50)
    let b = pkg::rect(50, 30, 100, 100)
    let ov = pkg::rect_intersect(a, b)
    say "Overlap: (" + str(ov.x) + ", " + str(ov.y) + ", " + str(ov.w) + ", " + str(ov.h) + ")"
    let u = pkg::rect_union(a, b)
    say "Union area: " + str(u.area())
    say ""

    say "--- Events ---"
    let q = pkg::event_queue()
    pkg::event_queue_push(q, pkg::event_new(pkg::GuiEventKind.MouseDown, 5, 6))
    pkg::event_queue_push(q, pkg::event_new(pkg::GuiEventKind.Close))
    say "Queued: " + str(pkg::event_queue_len(q))
    let ev = pkg::event_queue_poll(q)
    say "Polled kind: " + str(ev.kind)
    say "Remaining: " + str(pkg::event_queue_len(q))
    say ""

    say "--- Color ---"
    say pkg::rgba(137, 180, 250, 255).to_string()
    say ""
    say "Done!"
end

main()
