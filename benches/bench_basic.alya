## Benchmark suite for gui
## Part of the Alya Language package ecosystem (https://github.com/alya-lang)

import "std/test"
import "../src/lib.alya" as pkg

function main()
    let runner = bench_runner("gui Micro-Benchmarks")

    # Bench 1: rect intersect — 200k iterations
    let ba = pkg::rect(10, 10, 100, 50)
    let bb = pkg::rect(50, 30, 100, 100)
    bench_start(runner, 200000)
    let i = 0
    while i < 200000
        pkg::rect_intersect(ba, bb)
        i += 1
    end
    bench_stop(runner, "rect_intersect 200k calls")

    # Bench 2: event queue push+poll — 100k iterations
    bench_start(runner, 100000)
    let q = pkg::event_queue()
    let j = 0
    while j < 100000
        pkg::event_queue_push(q, pkg::event_new(pkg::GuiEventKind.Redraw))
        pkg::event_queue_poll(q)
        j += 1
    end
    bench_stop(runner, "queue push+poll 100k pairs")

    # Bench 3: backend_select — 50k iterations
    bench_start(runner, 50000)
    let k = 0
    while k < 50000
        pkg::backend()
        k += 1
    end
    bench_stop(runner, "backend_select 50k calls")

    # Bench 4: window config construction — 100k iterations
    bench_start(runner, 100000)
    let m = 0
    while m < 100000
        pkg::window("Bench", 800, 600)
        m += 1
    end
    bench_stop(runner, "window config 100k calls")

    bench_summary(runner)
end

main()
