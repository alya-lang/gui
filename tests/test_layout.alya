## Layout solver tests for gui
## Part of the Alya Language package ecosystem (https://github.com/alya-lang)

import "std/test"
import "../src/lib.alya" as pkg

function main()
    test_suite("gui Layout Tests")
    let r = runner_new()

    let c = pkg::rect(0, 0, 200, 200)
    let sizes = [pkg::size(0, 30), pkg::size(0, 40)]

    let rows: Rect[] = pkg::vbox(c, 10, 5, sizes)
    let r0: Rect = rows[0]
    let r1: Rect = rows[1]
    runner_assert_eq(r, len(rows), 2, "vbox two rows")
    runner_assert_eq(r, r0.x, 10, "vbox row0 x")
    runner_assert_eq(r, r0.y, 10, "vbox row0 y")
    runner_assert_eq(r, r0.w, 180, "vbox row fills inner width")
    runner_assert_eq(r, r0.h, 30, "vbox row0 keeps height")
    runner_assert_eq(r, r1.y, 45, "vbox row1 y with spacing")
    runner_assert_eq(r, r1.h, 40, "vbox row1 keeps height")

    let cols: Rect[] = pkg::hbox(c, 10, 5, sizes)
    let c0: Rect = cols[0]
    let c1: Rect = cols[1]
    runner_assert_eq(r, len(cols), 2, "hbox two cols")
    runner_assert_eq(r, c0.x, 10, "hbox col0 x")
    runner_assert_eq(r, c0.h, 180, "hbox col fills inner height")
    runner_assert_eq(r, c1.x, 15, "hbox col1 x with spacing")

    let empty = pkg::vbox(c, 10, 5, [])
    runner_assert_eq(r, len(empty), 0, "vbox empty input")

    let pad = pkg::layout_padding(c, 25)
    runner_assert_eq(r, pad.x, 25, "padding x")
    runner_assert_eq(r, pad.w, 150, "padding w")

    let m = pkg::margin(pkg::rect(10, 10, 100, 50), 5)
    runner_assert_eq(r, m.x, 5, "margin outset x")
    runner_assert_eq(r, m.y, 5, "margin outset y")
    runner_assert_eq(r, m.w, 110, "margin outset w")
    runner_assert_eq(r, m.h, 60, "margin outset h")

    let proot = pkg::widget("box", "proot")
    pkg::widget_set_rect(proot, pkg::rect(0, 0, 200, 200))
    let pa = pkg::button("pa", "A")
    let pb = pkg::button("pb", "B")
    pkg::widget_add_child(proot, pa)
    pkg::widget_add_child(proot, pb)
    let cells: Rect[] = pkg::vbox(pkg::rect(0, 0, 200, 200), 0, 0, [pkg::size(0, 30), pkg::size(0, 40)])
    runner_assert_eq(r, pkg::place(proot, cells), 2, "place assigns both")
    let placed: Widget = pkg::widget_find(proot, "pb")
    runner_assert_eq(r, placed.rect.y, 30, "placed rect y")
    runner_assert_eq(r, placed.rect.h, 40, "placed rect h")
    runner_assert_eq(r, pkg::place(proot, []), 0, "place empty is 0")
    runner_assert_eq(r, pkg::place(null, cells), 0, "place null is 0")

    let failed = runner_summary(r)
    if failed > 0
        exit(1)
    end
end

main()
