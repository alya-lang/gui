## Reactive signal tests for gui
## Part of the Alya Language package ecosystem (https://github.com/alya-lang)

import "std/test"
import "../src/lib.alya" as pkg

let fired = []

function watch_a(_s)
    fired.push("a")
    return 1
end

function watch_b(_s)
    fired.push("b")
    return 1
end

function main()
    test_suite("gui Signal Tests")
    let r = runner_new()

    # 1. Creation and reads
    let s = pkg::signal(10)
    runner_assert_eq(r, pkg::signal_value(s), 10, "initial value")
    runner_assert_eq(r, pkg::signal_version(s), 0, "initial version")
    runner_assert_eq(r, pkg::signal_observe(s, watch_a), 1, "first watcher")
    runner_assert_eq(r, pkg::signal_observe(s, watch_b), 2, "second watcher")

    # 2. Same-value assignment is a no-op
    runner_assert_eq(r, pkg::signal_assign(s, 10), 0, "same value returns 0")
    runner_assert_eq(r, pkg::signal_version(s), 0, "version unchanged")
    runner_assert_eq(r, len(fired), 0, "no watcher fired")

    # 3. Change notifies every watcher in order
    runner_assert_eq(r, pkg::signal_assign(s, 20), 1, "change returns 1")
    runner_assert_eq(r, pkg::signal_value(s), 20, "new value")
    runner_assert_eq(r, pkg::signal_version(s), 1, "version bumped")
    runner_assert_eq(r, len(fired), 2, "both watchers fired")
    runner_assert_str_eq(r, fired[0], "a", "first watcher first")
    runner_assert_str_eq(r, fired[1], "b", "second watcher second")

    # 4. Null safety
    runner_assert(r, pkg::signal_value(null) is null, "null signal reads null")
    runner_assert_eq(r, pkg::signal_assign(null, 1), 0, "null assign is 0")
    runner_assert_eq(r, pkg::signal_observe(null, watch_a), 0, "null observe is 0")

    # 5. Dirty lifecycle on widgets
    let w = pkg::label("st", "Ready")
    runner_assert_eq(r, pkg::widget_is_dirty(w), 0, "clean initially")
    runner_assert_eq(r, pkg::widget_mark_dirty(w), 1, "mark returns 1")
    runner_assert_eq(r, pkg::widget_is_dirty(w), 1, "dirty after mark")
    runner_assert_eq(r, pkg::widget_clear_dirty(w), 1, "clear returns 1")
    runner_assert_eq(r, pkg::widget_is_dirty(w), 0, "clean after clear")

    # 6. Text binding refreshes every bound widget
    let t = pkg::signal(0)
    let l1 = pkg::label("c1", "?")
    let l2 = pkg::label("c2", "?")
    let plain = pkg::label("plain", "?")
    runner_assert_eq(r, pkg::bind_text(t, l1), 1, "first bind")
    runner_assert_eq(r, pkg::bind_text(t, l2), 1, "second bind, one updater")
    runner_assert_str_eq(r, l1.text, "0", "initial bind text")
    runner_assert_eq(r, pkg::widget_is_dirty(l1), 1, "bind marks dirty")
    pkg::widget_clear_dirty(l1)
    pkg::widget_clear_dirty(l2)
    runner_assert_eq(r, pkg::signal_assign(t, 42), 1, "bound change")
    runner_assert_str_eq(r, l1.text, "42", "first widget refreshed")
    runner_assert_str_eq(r, l2.text, "42", "second widget refreshed")
    runner_assert_eq(r, pkg::widget_is_dirty(l1), 1, "refresh marks dirty")
    runner_assert_str_eq(r, plain.text, "?", "unbound untouched")

    # 7. Damage list + subtree clear (selective repaint input)
    pkg::widget_clear_dirty(l1)
    pkg::widget_clear_dirty(l2)
    pkg::widget_mark_dirty(l2)
    let dmg = pkg::dirty_ids(l1)
    runner_assert_eq(r, len(dmg), 0, "clean tree has no damage")
    let dtree = pkg::widget("box", "dtree")
    pkg::widget_add_child(dtree, l1)
    pkg::widget_add_child(dtree, l2)
    let dmg2 = pkg::dirty_ids(dtree)
    runner_assert_eq(r, len(dmg2), 1, "one dirty node")
    runner_assert_str_eq(r, dmg2[0], "c2", "damage id")
    runner_assert_eq(r, pkg::dirty_clear(dtree), 1, "clear returns count")
    runner_assert_eq(r, len(pkg::dirty_ids(dtree)), 0, "no damage after clear")
    runner_assert_eq(r, pkg::dirty_clear(null), 0, "clear null is 0")

    let failed = runner_summary(r)
    if failed > 0
        exit(1)
    end
end

main()
