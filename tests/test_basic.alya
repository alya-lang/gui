## Test suite for gui foundation
## Part of the Alya Language package ecosystem (https://github.com/alya-lang)

import "std/test"
import "../src/lib.alya" as pkg

function main()
    test_suite("gui Foundation Tests")
    let r = runner_new()

    # 1. Backend enum values are stable
    runner_assert_eq(r, pkg::GuiBackend.Unknown, 0, "GuiBackend.Unknown is 0")
    runner_assert_eq(r, pkg::GuiBackend.Windows, 1, "GuiBackend.Windows is 1")
    runner_assert_eq(r, pkg::GuiBackend.MacOs, 2, "GuiBackend.MacOs is 2")
    runner_assert_eq(r, pkg::GuiBackend.Wayland, 3, "GuiBackend.Wayland is 3")
    runner_assert_eq(r, pkg::GuiBackend.X11, 4, "GuiBackend.X11 is 4")

    # 2. Event kind enum values are stable
    runner_assert_eq(r, pkg::GuiEventKind.Close, 1, "GuiEventKind.Close is 1")
    runner_assert_eq(r, pkg::GuiEventKind.MouseDown, 4, "GuiEventKind.MouseDown is 4")
    runner_assert_eq(r, pkg::GuiEventKind.KeyDown, 6, "GuiEventKind.KeyDown is 6")
    runner_assert_eq(r, pkg::GuiEventKind.TextInput, 8, "GuiEventKind.TextInput is 8")

    # 3. Window config defaults and validation
    let wdef = pkg::window()
    runner_assert_str_eq(r, wdef.title, "Alya", "default title")
    runner_assert_eq(r, wdef.width, 640, "default width")
    runner_assert_eq(r, wdef.height, 480, "default height")
    let wbad = pkg::window("", -10, 0)
    runner_assert_str_eq(r, wbad.title, "Alya", "empty title falls back")
    runner_assert_eq(r, wbad.width, 640, "bad width falls back")
    runner_assert_eq(r, wbad.height, 480, "bad height falls back")

    # 4. Color constructors
    let c = pkg::rgb(10, 20, 30)
    runner_assert_eq(r, c.r, 10, "red channel")
    runner_assert_eq(r, c.a, 255, "rgb is opaque")
    runner_assert_str_eq(r, c.to_string(), "rgba(10, 20, 30, 255)", "color string")
    let t = pkg::rgba(1, 2, 3, 128)
    runner_assert_eq(r, t.a, 128, "alpha channel")

    # 5. Bundled C engine smoke test
    let c_sum = pkg::c_add(10, 32)
    runner_assert_eq(r, c_sum, 42, "pkg::c_add executes bundled C code")

    let failed = runner_summary(r)
    if failed > 0
        exit(1)
    end
end

main()
