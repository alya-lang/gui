## Accessibility contract tests for gui
## Part of the Alya Language package ecosystem (https://github.com/alya-lang)

import "std/test"
import "../src/lib.alya" as pkg

function main()
    test_suite("gui Accessibility Tests")
    let r = runner_new()

    # 1. Event kind values are stable (IME appended, nothing renumbered)
    runner_assert_eq(r, pkg::GuiEventKind.Redraw, 10, "Redraw still 10")
    runner_assert_eq(r, pkg::GuiEventKind.ImeStart, 11, "ImeStart is 11")
    runner_assert_eq(r, pkg::GuiEventKind.ImeUpdate, 12, "ImeUpdate is 12")
    runner_assert_eq(r, pkg::GuiEventKind.ImeEnd, 13, "ImeEnd is 13")

    # 2. Role enum values are stable
    runner_assert_eq(r, pkg::AccessibleRole.Button, 2, "Button role")
    runner_assert_eq(r, pkg::AccessibleRole.TextField, 4, "TextField role")
    runner_assert_eq(r, pkg::AccessibleRole.Canvas, 12, "Canvas role")

    # 3. Every control maps to its role
    runner_assert_eq(r, pkg::a11y_role(pkg::button("b", "OK")), 2, "button role")
    runner_assert_eq(r, pkg::a11y_role(pkg::label("l", "Hi")), 3, "label role")
    runner_assert_eq(r, pkg::a11y_role(pkg::textinput("t", "")), 4, "textinput role")
    runner_assert_eq(r, pkg::a11y_role(pkg::textarea("ta", "")), 4, "textarea role")
    runner_assert_eq(r, pkg::a11y_role(pkg::checkbox("c", 0)), 5, "checkbox role")
    runner_assert_eq(r, pkg::a11y_role(pkg::radio("r", "g", 0)), 6, "radio role")
    runner_assert_eq(r, pkg::a11y_role(pkg::slider("s", 0, 100, 50)), 7, "slider role")
    runner_assert_eq(r, pkg::a11y_role(pkg::progressbar("p", 0, 100, 50)), 8, "progress role")
    runner_assert_eq(r, pkg::a11y_role(pkg::dropdown("d", ["x"])), 9, "dropdown role")
    runner_assert_eq(r, pkg::a11y_role(pkg::listview("lv", ["x"])), 10, "listview role")
    runner_assert_eq(r, pkg::a11y_role(pkg::widget("mystery", "m")), 11, "unknown kind is container")

    # 4. Label contract: text wins, id is the fallback
    runner_assert_str_eq(r, pkg::a11y_label(pkg::button("ok", "Confirm")), "Confirm", "text label")
    runner_assert_str_eq(r, pkg::a11y_label(pkg::button("ok", "")), "ok", "id fallback")

    # 5. IME composition rides in GuiEvent.text
    let q = pkg::event_queue()
    pkg::event_queue_push(q, pkg::event_new(pkg::GuiEventKind.ImeUpdate, 0, 0, 0, "nihon"))
    let ev: GuiEvent = pkg::event_queue_poll(q)
    runner_assert_eq(r, ev.kind, pkg::GuiEventKind.ImeUpdate, "ime kind round-trips")
    runner_assert_str_eq(r, ev.text, "nihon", "composition text round-trips")

    # 6. Accessible tree export skips invisible subtrees
    let root = pkg::widget("box", "dlg")
    pkg::widget_set_rect(root, pkg::rect(0, 0, 200, 200))
    let okb = pkg::button("ok", "Confirm")
    pkg::widget_set_rect(okb, pkg::rect(10, 10, 80, 30))
    let hid = pkg::label("secret", "x")
    pkg::widget_set_visible(hid, 0)
    pkg::widget_add_child(root, okb)
    pkg::widget_add_child(root, hid)
    let tree = pkg::a11y_export(root)
    runner_assert_eq(r, len(tree), 2, "export has root + visible child")
    runner_assert_str_eq(r, tree[0]["id"], "dlg", "root record id")
    runner_assert_eq(r, tree[1]["role"], 2, "button role in record")
    runner_assert_str_eq(r, tree[1]["label"], "Confirm", "button label in record")
    runner_assert_eq(r, tree[1]["x"], 10, "button x in record")

    # 7. Keyboard-only audit: every control reachable and operable by keys
    let kre = pkg::widget("box", "kbd")
    pkg::widget_set_rect(kre, pkg::rect(0, 0, 200, 300))
    let kb = pkg::button("kb_ok", "Go")
    let kt = pkg::textinput("kb_name", "")
    let kc = pkg::checkbox("kb_agree", 0)
    let kr = pkg::radio("kb_r", "g", 0)
    let ks = pkg::slider("kb_vol", 0, 100, 50)
    let kd = pkg::dropdown("kb_th", ["a", "b"], 0)
    let kl = pkg::listview("kb_files", ["x", "y"])
    let ka = pkg::textarea("kb_notes", "")
    pkg::widget_set_rect(kb, pkg::rect(10, 10, 80, 30))
    pkg::widget_set_rect(kt, pkg::rect(10, 50, 120, 24))
    pkg::widget_set_rect(kc, pkg::rect(10, 80, 20, 20))
    pkg::widget_set_rect(kr, pkg::rect(10, 105, 20, 20))
    pkg::widget_set_rect(ks, pkg::rect(10, 130, 100, 20))
    pkg::widget_set_rect(kd, pkg::rect(10, 155, 80, 24))
    pkg::widget_set_rect(kl, pkg::rect(10, 185, 80, 40))
    pkg::widget_set_rect(ka, pkg::rect(10, 230, 120, 40))
    pkg::widget_add_child(kre, kb)
    pkg::widget_add_child(kre, kt)
    pkg::widget_add_child(kre, kc)
    pkg::widget_add_child(kre, kr)
    pkg::widget_add_child(kre, ks)
    pkg::widget_add_child(kre, kd)
    pkg::widget_add_child(kre, kl)
    pkg::widget_add_child(kre, ka)
    let kst = pkg::input()
    runner_assert_eq(r, pkg::key_press(kst, kre, 9), 1, "tab enters first control")
    runner_assert_str_eq(r, pkg::input_focused(kst), "kb_ok", "tab stops at button")
    runner_assert_eq(r, pkg::focus_next(kst, kre, 1), 1, "tab forward")
    runner_assert_str_eq(r, pkg::input_focused(kst), "kb_name", "tab stops at textinput")
    runner_assert_eq(r, pkg::text_enter(kst, kre, "amy"), 1, "keyboard types name")
    runner_assert_str_eq(r, kt.text, "amy", "typed text stored")
    runner_assert_eq(r, pkg::focus_next(kst, kre, 1), 1, "tab to checkbox")
    runner_assert_eq(r, pkg::key_press(kst, kre, 32), 1, "space toggles")
    runner_assert_eq(r, kc.value, 1, "checkbox on by keyboard")
    runner_assert_eq(r, pkg::focus_next(kst, kre, 1), 1, "tab to radio")
    runner_assert_eq(r, pkg::key_press(kst, kre, 32), 1, "space selects radio")
    runner_assert_eq(r, kr.value, 1, "radio on by keyboard")
    runner_assert_eq(r, pkg::focus_next(kst, kre, 1), 1, "tab to slider")
    runner_assert_eq(r, pkg::key_press(kst, kre, 39), 1, "arrow steps slider")
    runner_assert_eq(r, ks.value, 60, "slider moved by keyboard")
    runner_assert_eq(r, pkg::focus_next(kst, kre, 1), 1, "tab to dropdown")
    runner_assert_eq(r, pkg::key_press(kst, kre, 40), 1, "arrow picks option")
    runner_assert_eq(r, kd.value, 1, "dropdown moved by keyboard")
    runner_assert_eq(r, pkg::focus_next(kst, kre, 1), 1, "tab to listview")
    runner_assert_eq(r, pkg::key_press(kst, kre, 40), 1, "arrow selects row")
    runner_assert_eq(r, kl.value, 0, "list row by keyboard")
    runner_assert_eq(r, pkg::focus_next(kst, kre, 1), 1, "tab to textarea")
    runner_assert_str_eq(r, pkg::input_focused(kst), "kb_notes", "textarea reached")
    runner_assert_eq(r, pkg::text_enter(kst, kre, "hi"), 1, "textarea takes text")
    runner_assert_eq(r, pkg::focus_next(kst, kre, 1), 1, "tab wraps around")
    runner_assert_str_eq(r, pkg::input_focused(kst), "kb_ok", "wrap returns to first")
    runner_assert_eq(r, pkg::focus_next(kst, kre, -1), 1, "back-tab goes back")
    runner_assert_str_eq(r, pkg::input_focused(kst), "kb_notes", "backward wraps to last")

    # 8. IME composition state machine (ImeStart/Update/End kinds)
    let ist = pkg::input()
    let iroot = pkg::widget("box", "iroot")
    pkg::widget_set_rect(iroot, pkg::rect(0, 0, 200, 100))
    let iti = pkg::textinput("iname", "")
    pkg::widget_add_child(iroot, iti)
    runner_assert_eq(r, pkg::ime_start(ist, iroot), 0, "ime without focus ignored")
    runner_assert_eq(r, pkg::focus_widget(ist, iroot, "iname"), 1, "focus input")
    runner_assert_eq(r, pkg::ime_start(ist, iroot), 1, "ime starts")
    runner_assert_eq(r, pkg::ime_update(ist, iroot, "nihon"), 1, "preview stored")
    runner_assert_str_eq(r, pkg::composing_text(ist), "nihon", "composition visible")
    runner_assert_str_eq(r, iti.text, "", "preview not committed yet")
    runner_assert_eq(r, pkg::ime_end(ist, iroot, ""), 1, "end commits preview")
    runner_assert_str_eq(r, iti.text, "nihon", "preview committed")
    runner_assert_str_eq(r, pkg::composing_text(ist), "", "composition cleared")
    runner_assert_eq(r, pkg::ime_start(ist, iroot), 1, "ime restarts")
    runner_assert_eq(r, pkg::ime_end(ist, iroot, "kanji"), 1, "end commits final text")
    runner_assert_str_eq(r, iti.text, "nihonkanji", "final text appended")
    runner_assert_eq(r, pkg::apply_event(ist, iroot, pkg::event_new(pkg::GuiEventKind.ImeUpdate, 0, 0, 0, "ab")), 1, "event update routes")
    runner_assert_str_eq(r, pkg::composing_text(ist), "ab", "event preview stored")
    runner_assert_eq(r, pkg::apply_event(ist, iroot, pkg::event_new(pkg::GuiEventKind.ImeEnd, 0, 0, 0, "")), 1, "event end routes")
    runner_assert_str_eq(r, iti.text, "nihonkanjiab", "event preview committed")

    # 9. Screen-reader notify is null-safe headless
    runner_assert_eq(r, pkg::a11y_notify(null, 1), 0, "notify null win is 0")

    let failed = runner_summary(r)
    if failed > 0
        exit(1)
    end
end

main()
