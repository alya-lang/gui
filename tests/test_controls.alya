## Extended controls tests for gui
## Part of the Alya Language package ecosystem (https://github.com/alya-lang)

import "std/test"
import "../src/lib.alya" as pkg

let changed = []

function note_change(_w)
    changed.push("change")
    return 1
end

let bubbled = []

function note_bubble(w)
    bubbled.push(w.id)
    return 1
end

function main()
    test_suite("gui Controls Tests")
    let r = runner_new()

    # 1. Text area stores multi-line content
    let ta = pkg::textarea("notes", "line1\nline2")
    runner_assert_eq(r, ta.kind, "textarea", "textarea kind")
    runner_assert_str_eq(r, ta.text, "line1\nline2", "textarea content")

    # 2. Radio group exclusivity
    let root = pkg::widget("box", "root")
    pkg::widget_set_rect(root, pkg::rect(0, 0, 200, 200))
    let r1 = pkg::radio("r1", "grp", true)
    pkg::widget_set_rect(r1, pkg::rect(10, 10, 20, 20))
    let r2 = pkg::radio("r2", "grp", false)
    pkg::widget_set_rect(r2, pkg::rect(10, 40, 20, 20))
    let r3 = pkg::radio("r3", "other", true)
    pkg::widget_set_rect(r3, pkg::rect(10, 70, 20, 20))
    pkg::widget_add_child(root, r1)
    pkg::widget_add_child(root, r2)
    pkg::widget_add_child(root, r3)
    pkg::widget_on_change(r2, note_change)
    runner_assert_eq(r, pkg::click(root, 15, 45), true, "radio click consumed")
    runner_assert_eq(r, r1.value, false, "group mate deselected")
    runner_assert_eq(r, r2.value, true, "clicked radio selected")
    runner_assert_eq(r, r3.value, true, "other group untouched")
    runner_assert_eq(r, len(changed), 1, "radio change fired")

    # 3. Slider clamping and drag mapping
    let sl = pkg::slider("vol", 0, 100, 150)
    runner_assert_eq(r, sl.value, 100, "slider init clamped")
    let sl2 = pkg::slider("vol2", 0, 100, -5)
    runner_assert_eq(r, sl2.value, 0, "slider init floored")
    pkg::widget_set_rect(sl, pkg::rect(0, 0, 200, 20))
    let sroot = pkg::widget("box", "sroot")
    pkg::widget_set_rect(sroot, pkg::rect(0, 0, 200, 20))
    pkg::widget_add_child(sroot, sl)
    pkg::widget_on_change(sl, note_change)
    runner_assert_eq(r, pkg::click(sroot, 50, 10), true, "slider drag consumed")
    runner_assert_eq(r, sl.value, 25, "slider mapped from x")
    runner_assert_eq(r, pkg::click(sroot, 500, 10), true, "slider drag past end")
    runner_assert_eq(r, sl.value, 100, "slider clamped at max")

    # 4. Progress bar is display-only but settable at construction
    let pb = pkg::progressbar("dl", 0, 100, 30)
    runner_assert_eq(r, pb.value, 30, "progress value")
    let proot = pkg::widget("box", "proot")
    pkg::widget_set_rect(proot, pkg::rect(0, 0, 200, 20))
    pkg::widget_add_child(proot, pb)
    pkg::widget_set_rect(pb, pkg::rect(0, 0, 200, 20))
    runner_assert_eq(r, pkg::click(proot, 10, 10), false, "progress click not consumed")

    # 5. Dropdown selection clamping
    let dd = pkg::dropdown("theme", ["light", "dark"], 5)
    runner_assert_eq(r, dd.value, 1, "dropdown index clamped")
    runner_assert_str_eq(r, dd.options[1], "dark", "dropdown option read")
    let dde = pkg::dropdown("empty", [])
    runner_assert_eq(r, dde.value, -1, "empty dropdown is -1")

    # 6. List view starts unselected
    let lv = pkg::listview("files", ["a", "b", "c"])
    runner_assert_eq(r, lv.value, -1, "list starts unselected")
    runner_assert_eq(r, len(lv.options), 3, "list items stored")

    # 7. Grid layout: 5 children in 2 columns
    let cells: Rect[] = pkg::grid(pkg::rect(0, 0, 200, 200), 10, 5, 2, 40, 5)
    runner_assert_eq(r, len(cells), 5, "grid five cells")
    let g0: Rect = cells[0]
    runner_assert_eq(r, g0.x, 10, "grid cell00 x")
    runner_assert_eq(r, g0.y, 10, "grid cell00 y")
    runner_assert_eq(r, g0.w, 87, "grid cell width")
    let g1: Rect = cells[1]
    runner_assert_eq(r, g1.x, 102, "grid cell01 x")
    let g2: Rect = cells[2]
    runner_assert_eq(r, g2.y, 55, "grid cell10 y")
    let gnone = pkg::grid(pkg::rect(0, 0, 200, 200), 10, 5, 0, 40, 5)
    runner_assert_eq(r, len(gnone), 0, "grid zero cols empty")

    # 8. Bubble propagation: target handler first, else parent card
    let card = pkg::widget("box", "card")
    pkg::widget_set_rect(card, pkg::rect(0, 0, 200, 100))
    let inner = pkg::button("inner", "Go")
    pkg::widget_set_rect(inner, pkg::rect(10, 10, 80, 30))
    pkg::widget_add_child(card, inner)
    pkg::widget_on_click(card, note_bubble)
    runner_assert_eq(r, pkg::bubble(card, 15, 15), true, "bubble reaches card handler")
    runner_assert_str_eq(r, bubbled[0], "card", "card handler fired")
    pkg::widget_on_click(inner, note_bubble)
    runner_assert_eq(r, pkg::bubble(card, 15, 15), true, "target handler wins")
    runner_assert_str_eq(r, bubbled[1], "inner", "inner handler fired")
    runner_assert_eq(r, pkg::bubble(card, 150, 80), true, "card background bubbles to card")
    runner_assert_eq(r, pkg::bubble(card, 250, 250), false, "bubble miss is 0")
    let lone = pkg::widget("box", "lone")
    pkg::widget_set_rect(lone, pkg::rect(0, 0, 50, 50))
    runner_assert_eq(r, pkg::bubble(lone, 10, 10), false, "no handler is 0")

    # 9. Dropdown popup: toggle, row select, close, keyboard
    let droot = pkg::widget("box", "droot")
    pkg::widget_set_rect(droot, pkg::rect(0, 0, 200, 200))
    let dd2 = pkg::dropdown("dd2", ["light", "dark", "auto"], 0)
    pkg::widget_set_rect(dd2, pkg::rect(10, 10, 100, 24))
    pkg::widget_add_child(droot, dd2)
    pkg::widget_on_change(dd2, note_change)
    let ch0 = len(changed)
    runner_assert_eq(r, pkg::click(droot, 20, 22), true, "click opens dropdown")
    runner_assert_eq(r, dd2.open, true, "dropdown open flag")
    runner_assert_eq(r, pkg::click(droot, 20, 22), true, "click toggles closed")
    runner_assert_eq(r, dd2.open, false, "dropdown closed flag")
    runner_assert_eq(r, len(changed), ch0, "toggle fires no change")
    runner_assert_eq(r, pkg::click(droot, 20, 22), true, "reopen dropdown")
    runner_assert_eq(r, pkg::click(droot, 20, 79), true, "row click selects")
    runner_assert_eq(r, dd2.value, 2, "third option selected")
    runner_assert_eq(r, dd2.open, false, "select closes list")
    runner_assert_eq(r, len(changed), ch0 + 1, "select fires change")
    runner_assert_eq(r, pkg::click(droot, 150, 150), false, "outside click passes through")
    let dst = pkg::input()
    runner_assert_eq(r, pkg::focus_widget(dst, droot, "dd2"), true, "focus dropdown")
    runner_assert_eq(r, pkg::key_press(dst, droot, 13), true, "enter opens via keyboard")
    runner_assert_eq(r, dd2.open, true, "open via keyboard")
    runner_assert_eq(r, pkg::key_press(dst, droot, 27), true, "escape closes")
    runner_assert_eq(r, dd2.open, false, "closed via keyboard")    let failed = runner_summary(r)
    if failed > 0
        exit(1)
    end
end

main()
