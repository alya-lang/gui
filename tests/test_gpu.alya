## GPU surface tests for gui (Phase 2)
## Part of the Alya Language package ecosystem (https://github.com/alya-lang)
##
## Headless contract checks: null-safe wrappers, staging bounds, blit
## plumbing. Live pixels reach the screen only on display runners
## (see `test_native_window.alya` §3c on Windows).

import "std/test"
import "../src/lib.alya" as pkg

@cfg(feature = "native")
function main()
    test_suite("gui GPU Surface Tests")
    let r = runner_new()

    runner_assert(r, pkg::gpu_create(null, 64, 48) is null, "gpu create null win is null")
    runner_assert_eq(r, pkg::gpu_destroy(null), true, "gpu destroy null safe")
    runner_assert_eq(r, pkg::gpu_stage(null, 0, 255), false, "gpu stage null is 0")
    runner_assert_eq(r, pkg::gpu_present(null), false, "gpu present null is 0")
    runner_assert_eq(r, pkg::gpu_resize(null, 8, 8), false, "gpu resize null is 0")
    runner_assert_eq(r, pkg::gpu_text(null, "hi", 0, 0, 16, 255), false, "gpu text null is 0")
    runner_assert_eq(r, pkg::gpu_blit(null, null), 0, "gpu blit null is 0")

    let s = pkg::surface(4, 3, 255)
    runner_assert_eq(r, pkg::gpu_blit(s, null), 0, "gpu blit null surf is 0")
    let rw = pkg::widget("box", "rw")
    runner_assert_eq(r, pkg::render_tree(null, null, 64, 48), false, "render null root is 0")
    runner_assert_eq(r, pkg::render_tree(rw, null, 64, 48), false, "render null surf is 0")

    let failed = runner_summary(r)
    if failed > 0
        exit(1)
    end
end

# Native windowing needs the `native` feature: register an empty
# suite so the file still compiles and passes in slim views.
@cfg(not(feature = "native"))
function main()
    test_suite("gui GPU Surface Tests (skipped without native feature)")
    let r = runner_new()
    let failed = runner_summary(r)
    if failed > 0
        exit(1)
    end
end

main()
