## Rasterizer tests for gui
## Part of the Alya Language package ecosystem (https://github.com/alya-lang)

import "std/test"
import "../src/lib.alya" as pkg

function main()
    test_suite("gui Raster Tests")
    let r = runner_new()

    # 1. Construction and solid fill
    let img = pkg::canvas(4, 3, 0)
    runner_assert_eq(r, pkg::image_get_px(img, 0, 0), 0, "fresh pixel")
    runner_assert_eq(r, pkg::image_get_px(img, 9, 9), -1, "OOB reads -1")
    runner_assert_eq(r, pkg::image_set_px(img, 9, 9, 7), 0, "OOB write clipped")
    runner_assert_eq(r, pkg::canvas_fill(img, 5), 12, "fill paints all")
    runner_assert_eq(r, pkg::image_get_px(img, 3, 2), 5, "fill value")

    # 2. Clipped rectangle
    let rc = pkg::canvas(5, 5, 0)
    runner_assert_eq(r, pkg::canvas_rect(rc, 1, 1, 3, 2, 9), 6, "rect paints 6")
    runner_assert_eq(r, pkg::image_get_px(rc, 1, 1), 9, "rect corner")
    runner_assert_eq(r, pkg::image_get_px(rc, 0, 0), 0, "outside untouched")
    runner_assert_eq(r, pkg::canvas_rect(rc, 3, 3, 10, 10, 7), 4, "clipped rect paints 4")

    # 3. Diagonal line
    let ln = pkg::canvas(5, 5, 0)
    runner_assert_eq(r, pkg::canvas_line(ln, 0, 0, 4, 4, 3), 5, "diagonal paints 5")
    runner_assert_eq(r, pkg::image_get_px(ln, 2, 2), 3, "diagonal middle")
    runner_assert_eq(r, pkg::image_get_px(ln, 0, 4), 0, "off-diagonal empty")

    # 4. Circle outline hits cardinal points
    let ci = pkg::canvas(11, 11, 0)
    runner_assert(r, pkg::canvas_circle(ci, 5, 5, 4, 8) > 0, "circle paints")
    runner_assert_eq(r, pkg::image_get_px(ci, 9, 5), 8, "east point")
    runner_assert_eq(r, pkg::image_get_px(ci, 5, 1), 8, "north point")
    runner_assert_eq(r, pkg::image_get_px(ci, 5, 5), 0, "center empty")

    # 5. PPM export shape
    let tiny = pkg::canvas(2, 1, 0)
    pkg::image_set_px(tiny, 0, 0, 16711680)
    let ppm = pkg::canvas_ppm(tiny)
    runner_assert(r, len(ppm) > 10, "ppm non-empty")
    runner_assert_str_eq(r, substring(ppm, 0, 2), "P3", "ppm magic")
    runner_assert(r, pkg::image_get_px(tiny, 1, 0) == 0, "second pixel black")

    # 6. Integer square root
    runner_assert_eq(r, pkg::image_isqrt(-5), 0, "isqrt negative is 0")
    runner_assert_eq(r, pkg::image_isqrt(0), 0, "isqrt zero")
    runner_assert_eq(r, pkg::image_isqrt(15), 3, "isqrt floors")
    runner_assert_eq(r, pkg::image_isqrt(16), 4, "isqrt exact")
    runner_assert_eq(r, pkg::image_isqrt(100), 10, "isqrt hundred")

    # 7. Filled disc keeps edges, drops outside
    let dc = pkg::canvas(11, 11, 0)
    runner_assert(r, pkg::image_circle_filled(dc, 5, 5, 3, 6) > 0, "disc paints")
    runner_assert_eq(r, pkg::image_get_px(dc, 5, 5), 6, "disc center")
    runner_assert_eq(r, pkg::image_get_px(dc, 8, 5), 6, "disc east edge")
    runner_assert_eq(r, pkg::image_get_px(dc, 5, 2), 6, "disc north tip")
    runner_assert_eq(r, pkg::image_get_px(dc, 9, 5), 0, "disc outside empty")
    runner_assert_eq(r, pkg::image_get_px(dc, 5, 1), 0, "disc above tip empty")

    # 8. Rounded rect cuts corners, fills body
    let rr = pkg::canvas(10, 10, 0)
    runner_assert(r, pkg::image_rect_rounded(rr, 0, 0, 10, 10, 3, 7) > 0, "rounded paints")
    runner_assert_eq(r, pkg::image_get_px(rr, 0, 0), 0, "corner cut")
    runner_assert_eq(r, pkg::image_get_px(rr, 9, 0), 0, "corner cut far")
    runner_assert_eq(r, pkg::image_get_px(rr, 0, 9), 0, "corner cut bottom")
    runner_assert_eq(r, pkg::image_get_px(rr, 5, 0), 7, "top edge kept")
    runner_assert_eq(r, pkg::image_get_px(rr, 0, 5), 7, "left edge kept")
    runner_assert_eq(r, pkg::image_get_px(rr, 5, 5), 7, "center filled")
    runner_assert_eq(r, pkg::image_get_px(rr, 1, 1), 7, "inner corner filled")

    let failed = runner_summary(r)
    if failed > 0
        exit(1)
    end
end

main()
