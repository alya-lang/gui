## Widget tree and click dispatch tests for gui
## Part of the Alya Language package ecosystem (https://github.com/alya-lang)

import "std/test"
import "../src/lib.alya" as pkg

let fired = []

function record_click(_w)
    fired.push("click")
    return 1
end

function record_change(_w)
    fired.push("change")
    return 1
end

function main()
    test_suite("gui Widget Tests")
    let r = runner_new()

    # 1. Tree construction and lookup
    let root = pkg::widget("box", "root")
    pkg::widget_set_rect(root, pkg::rect(0, 0, 200, 200))
    let btn = pkg::button("ok", "OK")
    pkg::widget_set_rect(btn, pkg::rect(10, 10, 80, 30))
    let lbl = pkg::label("title", "Hi")
    pkg::widget_set_rect(lbl, pkg::rect(10, 50, 80, 20))
    runner_assert_eq(r, pkg::widget_add_child(root, btn), 1, "first child")
    runner_assert_eq(r, pkg::widget_add_child(root, lbl), 2, "second child")
    runner_assert_eq(r, pkg::widget_child_count(root), 2, "child count")
    runner_assert(r, pkg::widget_find(root, "ok") is not null, "find by id")
    runner_assert(r, pkg::widget_find(root, "missing") is null, "find missing is null")
    runner_assert(r, pkg::widget_child(root, 5) is null, "child OOB is null")

    # 2. Hit-testing: deepest node wins
    let hit_btn = pkg::widget_hit(root, 20, 20)
    runner_assert_str_eq(r, hit_btn.id, "ok", "hit button")
    let hit_lbl = pkg::widget_hit(root, 20, 55)
    runner_assert_str_eq(r, hit_lbl.id, "title", "hit label")
    let hit_root = pkg::widget_hit(root, 150, 150)
    runner_assert_str_eq(r, hit_root.id, "root", "hit root fallback")
    runner_assert(r, pkg::widget_hit(root, 500, 500) is null, "hit outside is null")

    # 3. Click dispatch invokes the button callback
    pkg::widget_on_click(btn, record_click)
    runner_assert_eq(r, pkg::click(root, 20, 20), 1, "click consumed")
    runner_assert_eq(r, len(fired), 1, "callback fired once")
    runner_assert_eq(r, pkg::click(root, 500, 500), 0, "miss returns 0")

    # 4. Checkbox toggles state and fires on_change
    let cb = pkg::checkbox("agree", 0)
    pkg::widget_set_rect(cb, pkg::rect(10, 100, 20, 20))
    pkg::widget_add_child(root, cb)
    pkg::widget_on_change(cb, record_change)
    runner_assert_eq(r, pkg::click(root, 15, 110), 1, "checkbox click consumed")
    runner_assert_eq(r, cb.value, 1, "checkbox toggled on")
    runner_assert_eq(r, len(fired), 2, "change fired")
    runner_assert_eq(r, pkg::click(root, 15, 110), 1, "second click consumed")
    runner_assert_eq(r, cb.value, 0, "checkbox toggled off")

    # 5. Disabled and hidden nodes never dispatch
    pkg::widget_set_enabled(btn, 0)
    runner_assert_eq(r, pkg::click(root, 20, 20), 0, "disabled button ignored")
    runner_assert_eq(r, len(fired), 3, "no extra callback")
    pkg::widget_set_enabled(btn, 1)
    pkg::widget_set_visible(lbl, 0)
    runner_assert(r, pkg::widget_hit(root, 20, 55) is not null, "hidden label skipped, root hit")
    runner_assert_str_eq(r, pkg::widget_hit(root, 20, 55).id, "root", "falls back to root")

    # 6. Text input stores content
    let ti = pkg::textinput("name", "Ada")
    runner_assert_str_eq(r, ti.text, "Ada", "input content")
    pkg::widget_set_text(ti, "Grace")
    runner_assert_str_eq(r, ti.text, "Grace", "set text")

    let failed = runner_summary(r)
    if failed > 0
        exit(1)
    end
end

main()
