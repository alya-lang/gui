## Native window tests for gui (Phase 1 windowing + Phase 3 input pump)
## Part of the Alya Language package ecosystem (https://github.com/alya-lang)
##
## Real OS windows: skipped (passing) on headless runners.

import "std/test"
import "../src/lib.alya" as pkg

function main()
    test_suite("gui Native Window Tests")
    let r = runner_new()

    if pkg::backend() != "windows"
        runner_assert(r, 1 == 1, "native window tests run on Windows only")
        let done0 = runner_summary(r)
        if done0 > 0
            exit(1)
        end
        return
    end

    # 1. Create (hidden) + liveness (null = headless, skip passing)
    let win = pkg::native_open("Alya CI Probe", 320, 200)
    if win is null
        runner_assert(r, 1 == 1, "no display, skipped")
        let done0 = runner_summary(r)
        if done0 > 0
            exit(1)
        end
        return
    end
    runner_assert_eq(r, pkg::native_is_open(win), 1, "window open")

    # 2. Show + pump (drains any initial paint/resize noise)
    runner_assert_eq(r, pkg::native_show(win), 1, "show returns 1")
    let i = 0
    while i < 20
        pkg::native_poll(win)
        i += 1
    end
    runner_assert_eq(r, pkg::native_is_open(win), 1, "still open")

    # 3. Resize flows through a RESIZE event with the new size
    runner_assert_eq(r, pkg::native_resize(win, 400, 300), 1, "resize requested")
    let rkind = 0
    let rticks = 0
    while rticks < 100
        rkind = pkg::native_poll(win)
        if rkind == 2
            break
        end
        rticks += 1
    end
    runner_assert_eq(r, rkind, 2, "RESIZE event pumped")
    runner_assert_eq(r, pkg::native_event_width(), 400, "resized width")
    runner_assert_eq(r, pkg::native_event_height(), 300, "resized height")

    # 3b. Drain maps native events to GuiEvent records (size in w/h)
    runner_assert_eq(r, pkg::native_resize(win, 420, 320), 1, "resize 2 requested")
    let dq = pkg::event_queue()
    let dfound = 0
    let dticks = 0
    while dticks < 200
        pkg::native_drain(win, dq)
        while pkg::event_queue_len(dq) > 0
            let dev: GuiEvent = pkg::event_queue_poll(dq)
            if dev.kind == 2 and dev.w == 420 and dev.h == 320
                dfound = 1
            end
        end
        if dfound == 1
            break
        end
        dticks += 1
    end
    runner_assert_eq(r, dfound, 1, "drain maps RESIZE with size")

    # 3c. GPU surface: create/stage/blit/present/resize/destroy live
    let gs = pkg::gpu_create(win, 64, 48)
    if gs is null
        runner_assert(r, 1 == 1, "no GPU, skipped")
    else
        runner_assert_eq(r, pkg::gpu_stage(gs, 0, 16711680), 1, "gpu stage stored")
        runner_assert_eq(r, pkg::gpu_stage(gs, 99999, 255), 0, "gpu stage OOB ignored")
        let bs = pkg::surface(64, 48, 255)
        runner_assert_eq(r, pkg::gpu_blit(bs, gs), 3072, "gpu blit staged all pixels")
        runner_assert_eq(r, pkg::gpu_present(gs), 1, "gpu present shown")
        runner_assert_eq(r, pkg::gpu_resize(gs, 32, 24), 1, "gpu resize ok")
        runner_assert_eq(r, pkg::gpu_destroy(gs), 1, "gpu destroy ok")
    end

    # 4. Graceful close -> CLOSE event -> not open
    runner_assert_eq(r, pkg::native_request_close(win), 1, "close requested")
    let kind = 0
    let ticks = 0
    while ticks < 100
        kind = pkg::native_poll(win)
        if kind == 1
            break
        end
        ticks += 1
    end
    runner_assert_eq(r, kind, 1, "CLOSE event pumped")
    runner_assert_eq(r, pkg::native_is_open(win), 0, "closed after event")

    # 4. Null safety
    runner_assert_eq(r, pkg::native_poll(null), 0, "poll null is 0")
    runner_assert_eq(r, pkg::native_drain(null, pkg::event_queue()), 0, "drain null win is 0")
    runner_assert_eq(r, pkg::native_drain(win, null), 0, "drain null queue is 0")
    runner_assert_eq(r, pkg::native_is_open(null), 0, "is_open null is 0")
    runner_assert_eq(r, pkg::native_destroy(null), 1, "destroy null safe")
    pkg::native_destroy(win)

    let failed = runner_summary(r)
    if failed > 0
        exit(1)
    end
end

main()
