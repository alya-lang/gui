## gui Library Facade
##
## Part of the Alya Language package ecosystem (https://github.com/alya-lang).
## Primary entry point for the native GUI toolkit foundation: geometry
## primitives, backend detection, and the portable event queue. Native
## windowing/rendering backends (Win32, Cocoa, Wayland/X11) build on top.

import "./types.alya"
import "./core/geometry.alya"
import "./core/backend.alya"
import "./core/events.alya"
import "./core/input.alya"
import "./core/state.alya"
import "./core/layout.alya"
import "./core/raster.alya"
import "./canvas/context.alya"
import "./canvas/surface.alya"
import "./widgets/node.alya"
import "./widgets/controls.alya"
import "./widgets/containers.alya"
import "./native/window.alya"
import "./ffi.alya"

## Creates a window configuration with validated dimensions.
pub function window(title: string = "Alya", width: int = 640, height: int = 480) -> WindowConfig
    return window_config_new(title, width, height)
end

## Selects the native backend name for the host (`"windows"`, `"macos"`,
## `"wayland"`, `"x11"`, or `"unknown"`).
pub function backend() -> string
    return backend_select()
end

## Collects backend name, OS name, and display endpoint in one record.
pub function backend_details() -> BackendInfo
    return backend_info()
end

## Creates an empty GUI event queue.
pub function event_queue() -> GuiEventQueue
    return event_queue_new()
end

## Creates a signal holding an initial payload.
pub function signal(v) -> Signal
    return signal_new(v)
end

## Returns a signal's current payload.
pub function signal_value(s: Signal)
    return signal_get(s)
end

## Assigns a signal payload, notifying on change (see `signal_set`).
pub function signal_assign(s: Signal, v) -> int
    return signal_set(s, v)
end

## Subscribes `fn(sig)` to a signal (see `signal_watch`).
pub function signal_observe(s: Signal, cb) -> int
    return signal_watch(s, cb)
end

## Binds a signal to a widget's text (see `bind_signal_text`).
pub function bind_text(sig: Signal, w: Widget) -> int
    return bind_signal_text(sig, w)
end

## Builds an opaque RGB color.
pub function rgb(r: int, g: int, b: int) -> Color
    return color_rgb(r, g, b)
end

## Builds an RGBA color.
pub function rgba(r: int, g: int, b: int, a: int = 255) -> Color
    return color_rgba(r, g, b, a)
end

## Builds 2D dimensions.
pub function size(w: int = 0, h: int = 0) -> Size
    return size_new(w, h)
end

## Builds a rectangle from origin plus dimensions.
pub function rect(x: int = 0, y: int = 0, w: int = 0, h: int = 0) -> Rect
    return rect_new(x, y, w, h)
end

## Returns the overlap area of two rects (`0` when disjoint).
##
## Damage-region helper composing `rect_intersect` with `Rect.area`.
pub function overlap_area(a: Rect, b: Rect) -> int
    return rect_intersect(a, b).area()
end

## Creates a generic widget node.
pub function widget(kind: string, id: string = "") -> Widget
    return widget_new(kind, id)
end

## Creates a push button with caption text.
pub function button(id: string, text: string = "") -> Widget
    return button_new(id, text)
end

## Creates a static text label.
pub function label(id: string, text: string = "") -> Widget
    return label_new(id, text)
end

## Creates a single-line text input.
pub function textinput(id: string, text: string = "") -> Widget
    return textinput_new(id, text)
end

## Creates a checkbox (`checked` sets the initial flag).
pub function checkbox(id: string, checked: int = 0) -> Widget
    return checkbox_new(id, checked)
end

## Creates a multi-line text area.
pub function textarea(id: string, text: string = "") -> Widget
    return textarea_new(id, text)
end

## Creates a radio button in a group.
pub function radio(id: string, group: string, selected: int = 0) -> Widget
    return radio_new(id, group, selected)
end

## Creates a slider with clamped initial value.
pub function slider(id: string, min_val: int, max_val: int, value: int) -> Widget
    return slider_new(id, min_val, max_val, value)
end

## Creates a progress bar with clamped initial value.
pub function progressbar(id: string, min_val: int, max_val: int, value: int) -> Widget
    return progressbar_new(id, min_val, max_val, value)
end

## Creates a dropdown with options and selected index.
pub function dropdown(id: string, options: array, selected: int = 0) -> Widget
    return dropdown_new(id, options, selected)
end

## Creates a list view with items.
pub function listview(id: string, items: array) -> Widget
    return listview_new(id, items)
end

## Creates a stack container (see `stack_new`).
pub function stack(id: string) -> Widget
    return stack_new(id)
end

## Selects a stack child (see `stack_select`).
pub function stack_pick(stack: Widget, index: int) -> int
    return stack_select(stack, index)
end

## Creates scroll offset state (see `scroll_state_new`).
pub function scrollstate(view_w: int, view_h: int, content_w: int, content_h: int) -> ScrollState
    return scroll_state_new(view_w, view_h, content_w, content_h)
end

## Moves scroll offsets (see `scroll_to`).
pub function scrollmove(st: ScrollState, x: int, y: int) -> int
    return scroll_to(st, x, y)
end

## Creates a splitter holding a percentage (see `splitter_new`).
pub function splitter(id: string, ratio: int) -> Widget
    return splitter_new(id, ratio)
end

## Splits a container per ratio (see `split_rects`).
pub function split(container: Rect, ratio: int, vertical: int) -> array
    return split_rects(container, ratio, vertical)
end

## Returns the screen-reader role for a widget (see `accessible_role`).
pub function a11y_role(w: Widget) -> int
    return accessible_role(w)
end

## Returns the accessible label for a widget (see `accessible_label`).
pub function a11y_label(w: Widget) -> string
    return accessible_label(w)
end

## Dispatches a point click over a widget tree (see `dispatch_click`).
pub function click(root: Widget, x: int, y: int) -> int
    return dispatch_click(root, x, y)
end

## Creates empty mouse/keyboard input state (see `input_new`).
pub function input() -> InputState
    return input_new()
end

## Routes mouse motion, updating hover (see `dispatch_mouse_move`).
pub function mouse_move(st: InputState, root: Widget, x: int, y: int) -> int
    return dispatch_mouse_move(st, root, x, y)
end

## Routes a mouse press, arming click + focus (see `dispatch_mouse_down`).
pub function mouse_down(st: InputState, root: Widget, x: int, y: int) -> int
    return dispatch_mouse_down(st, root, x, y)
end

## Routes a mouse release, activating on press-widget release (see `dispatch_mouse_up`).
pub function mouse_up(st: InputState, root: Widget, x: int, y: int) -> int
    return dispatch_mouse_up(st, root, x, y)
end

## Routes a key press to the focused widget (see `dispatch_key`).
pub function key_press(st: InputState, root: Widget, key: int) -> int
    return dispatch_key(st, root, key)
end

## Routes committed text to the focused input (see `dispatch_text`).
pub function text_enter(st: InputState, root: Widget, text: string) -> int
    return dispatch_text(st, root, text)
end

## Applies one queued event to the tree (see `dispatch_event`).
pub function apply_event(st: InputState, root: Widget, ev: GuiEvent) -> int
    return dispatch_event(st, root, ev)
end

## Focuses a widget by id (see `input_focus`).
pub function focus_widget(st: InputState, root: Widget, id: string) -> int
    return input_focus(st, root, id)
end

## Maps a widget kind to its cursor style (see `cursor_for`).
pub function cursor(kind: string) -> string
    return cursor_for(kind)
end

## Opens a native OS window; null when headless (see `native_window_open`).
pub function native_open(title: string, width: int, height: int)
    return native_window_open(title, width, height)
end

## Destroys a native window handle (null-safe, see `native_window_close_handle`).
pub function native_destroy(win) -> int
    return native_window_close_handle(win)
end

## Shows a native window (see `native_window_show`).
pub function native_show(win) -> int
    return native_window_show(win)
end

## Returns 1 while the native window is open (see `native_window_is_open`).
pub function native_is_open(win) -> int
    return native_window_is_open(win)
end

## Requests a graceful native close (see `native_window_request_close`).
pub function native_request_close(win) -> int
    return native_window_request_close(win)
end

## Resizes the native window client area (see `native_window_resize`).
pub function native_resize(win, width: int, height: int) -> int
    return native_window_resize(win, width, height)
end

## Pumps one native event; returns its kind (see `native_window_poll`).
pub function native_poll(win) -> int
    return native_window_poll(win)
end

## Drains pending native events into `q` as records (see `native_window_drain`).
pub function native_drain(win, q: GuiEventQueue) -> int
    return native_window_drain(win, q)
end

## Last pumped event: client width (resize) in pixels.
pub function native_event_width() -> int
    return alya_gui_event_width()
end

## Last pumped event: client height.
pub function native_event_height() -> int
    return alya_gui_event_height()
end

## Last pumped event: mouse x.
pub function native_event_mouse_x() -> int
    return alya_gui_event_mouse_x()
end

## Last pumped event: mouse y.
pub function native_event_mouse_y() -> int
    return alya_gui_event_mouse_y()
end

## Last pumped event: key code (`0` when none).
pub function native_event_key() -> int
    return native_window_event_key()
end

## Last pumped `TextInput` event: UTF-8 text (`""` when none).
pub function native_event_text() -> string
    return native_window_event_text()
end

## Stacks child sizes top-down inside a container (see `layout_vbox`).
pub function vbox(container: Rect, padding: int, spacing: int, sizes: Size[]) -> Rect[]
    return layout_vbox(container, padding, spacing, sizes)
end

## Stacks child sizes left-to-right inside a container (see `layout_hbox`).
pub function hbox(container: Rect, padding: int, spacing: int, sizes: Size[]) -> Rect[]
    return layout_hbox(container, padding, spacing, sizes)
end

## Arranges children in a uniform grid (see `layout_grid`).
pub function grid(container: Rect, padding: int, spacing: int, cols: int, cell_h: int, count: int) -> Rect[]
    return layout_grid(container, padding, spacing, cols, cell_h, count)
end

## Creates a solid-color pixel canvas (see `image_new`).
pub function canvas(w: int, h: int, color: int = 0) -> Image
    return image_new(w, h, color)
end

## Fills a canvas (see `image_fill`).
pub function canvas_fill(img: Image, color: int) -> int
    return image_fill(img, color)
end

## Paints a clipped rectangle (see `image_rect`).
pub function canvas_rect(img: Image, x: int, y: int, w: int, h: int, color: int) -> int
    return image_rect(img, x, y, w, h, color)
end

## Draws a 1px line (see `image_line`).
pub function canvas_line(img: Image, x0: int, y0: int, x1: int, y1: int, color: int) -> int
    return image_line(img, x0, y0, x1, y1, color)
end

## Draws a 1px circle outline (see `image_circle`).
pub function canvas_circle(img: Image, cx: int, cy: int, radius: int, color: int) -> int
    return image_circle(img, cx, cy, radius, color)
end

## Exports a canvas as PPM text (see `image_to_ppm`).
pub function canvas_ppm(img: Image) -> string
    return image_to_ppm(img)
end

## Creates a drawing context over a solid canvas (see `drawctx_new`).
pub function drawctx(w: int, h: int, bg: int = 0) -> DrawContext
    return drawctx_new(w, h, bg)
end

## Fills a context canvas (see `ctx_clear`).
pub function ctxclear(ctx: DrawContext, color: int) -> int
    return ctx_clear(ctx, color)
end

## Sets context stroke (see `ctx_set_stroke`).
pub function ctxstroke(ctx: DrawContext, color: Color, w: int = 1) -> int
    return ctx_set_stroke(ctx, color, w)
end

## Sets context fill (see `ctx_set_fill`).
pub function ctxfill(ctx: DrawContext, color: Color) -> int
    return ctx_set_fill(ctx, color)
end

## Strokes a line on a context (see `ctx_line`).
pub function ctxline(ctx: DrawContext, x0: int, y0: int, x1: int, y1: int) -> int
    return ctx_line(ctx, x0, y0, x1, y1)
end

## Strokes a rectangle on a context (see `ctx_rect`).
pub function ctxrect(ctx: DrawContext, x: int, y: int, w: int, h: int) -> int
    return ctx_rect(ctx, x, y, w, h)
end

## Fills a rectangle on a context (see `ctx_fill_rect`).
pub function ctxfillrect(ctx: DrawContext, x: int, y: int, w: int, h: int) -> int
    return ctx_fill_rect(ctx, x, y, w, h)
end

## Strokes a circle on a context (see `ctx_circle`).
pub function ctxcircle(ctx: DrawContext, cx: int, cy: int, radius: int) -> int
    return ctx_circle(ctx, cx, cy, radius)
end

## Exports a context canvas as PPM (see `ctx_ppm`).
pub function ctxppm(ctx: DrawContext) -> string
    return ctx_ppm(ctx)
end

## Creates a drawable surface (see `surface_new`).
pub function surface(w: int, h: int, bg: int = 0) -> DrawSurface
    return surface_new(w, h, bg)
end

## Returns a surface drawing context (see `surface_ctx`).
pub function surface_draw(s: DrawSurface)
    return surface_ctx(s)
end

## Presents a surface (see `surface_present`).
pub function surface_show(s: DrawSurface) -> int
    return surface_present(s)
end

## Rebuilds a surface at a new size (see `surface_resize`).
pub function surface_reshape(s: DrawSurface, w: int, h: int, bg: int = 0) -> int
    return surface_resize(s, w, h, bg)
end

## Native C FFI helper (bundled engine smoke test).
pub function c_add(a: int = 0, b: int = 0) -> int
    return alya_gui_add(a, b)
end
