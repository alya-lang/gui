## gui Types & Data Structures
##
## Part of the Alya Language package ecosystem (https://github.com/alya-lang).
## Platform-neutral models for the native GUI toolkit: geometry primitives,
## color, window configuration, backend selection, and input/window events.
## All rendering and windowing backends (Win32, Cocoa, Wayland/X11) build on
## these types; nothing here touches the OS, so it is fully headless-testable.

# ───────────────────────────────────────────────────────────────
# Enumerations
# ───────────────────────────────────────────────────────────────

## Native rendering/windowing backend selected for the host OS.
##
## Values are stable (`Unknown = 0`) so callers can persist or compare them.
pub enum GuiBackend
    Unknown = 0,
    Windows = 1,
    MacOs = 2,
    Wayland = 3,
    X11 = 4
end

## Window and input event kinds delivered through the event queue.
##
## Mirrors the native OS event pump (mouse, keyboard, resize, focus, close).
pub enum GuiEventKind
    None = 0,
    Close = 1,
    Resize = 2,
    MouseMove = 3,
    MouseDown = 4,
    MouseUp = 5,
    KeyDown = 6,
    KeyUp = 7,
    TextInput = 8,
    Focus = 9,
    Redraw = 10,
    ImeStart = 11,
    ImeUpdate = 12,
    ImeEnd = 13
end

## Screen-reader roles for widgets (Phase 6 accessibility milestone).
##
## Every widget maps to exactly one role; see `accessible_role`.
pub enum AccessibleRole
    Unknown = 0,
    Window = 1,
    Button = 2,
    Label = 3,
    TextField = 4,
    Checkbox = 5,
    RadioButton = 6,
    Slider = 7,
    ProgressBar = 8,
    Dropdown = 9,
    List = 10,
    Container = 11,
    Canvas = 12
end

# ───────────────────────────────────────────────────────────────
# Geometry Primitives
# ───────────────────────────────────────────────────────────────

## 2D integer point in device pixels.
##
## ### Fields
## - `x`: Horizontal coordinate.
## - `y`: Vertical coordinate.
pub struct Point
    x: int,
    y: int
end

## 2D integer dimensions in device pixels.
##
## ### Fields
## - `w`: Width (>= 0 for valid sizes).
## - `h`: Height (>= 0 for valid sizes).
pub struct Size
    w: int,
    h: int
end

## Integer rectangle: origin plus dimensions.
##
## A rect with `w <= 0` or `h <= 0` is empty (see `rect_is_empty`).
##
## ### Fields
## - `x`: Left edge.
## - `y`: Top edge.
## - `w`: Width.
## - `h`: Height.
pub struct Rect
    x: int,
    y: int,
    w: int,
    h: int
end

## RGBA color with 8-bit channels.
##
## ### Fields
## - `r`: Red channel (0-255).
## - `g`: Green channel (0-255).
## - `b`: Blue channel (0-255).
## - `a`: Alpha channel (0 transparent, 255 opaque).
pub struct Color
    r: int,
    g: int,
    b: int,
    a: int
end

# ───────────────────────────────────────────────────────────────
# Window & Backend Models
# ───────────────────────────────────────────────────────────────

## Window creation parameters (backend-neutral).
##
## ### Fields
## - `title`: Window title text.
## - `width`: Client width in device pixels.
## - `height`: Client height in device pixels.
pub struct WindowConfig
    title: string,
    width: int,
    height: int
end

## Host backend detection result.
##
## ### Fields
## - `backend`: Backend name (`"windows"`, `"macos"`, `"wayland"`, `"x11"`, `"unknown"`).
## - `os`: OS name from `std/os`.
## - `display`: Display endpoint (`WAYLAND_DISPLAY` / `DISPLAY` / `""`).
pub struct BackendInfo
    backend: string,
    os: string,
    display: string
end

## Single window/input event record.
##
## Unused slots stay at their zero values (`0` / `""`) per kind.
##
## ### Fields
## - `kind`: `GuiEventKind` value.
## - `x`: Mouse x coordinate (mouse kinds); packed width (Resize kind).
## - `y`: Mouse y coordinate (mouse kinds); packed height (Resize kind).
## - `key`: Key code (keyboard kinds); focus flag (Focus kind).
## - `text`: Input text (TextInput kind).
## - `w`: Client width (Resize kind).
## - `h`: Client height (Resize kind).
pub struct GuiEvent
    kind: int,
    x: int,
    y: int,
    key: int,
    text: string,
    w: int,
    h: int
end

# ───────────────────────────────────────────────────────────────
# Constructors
# ───────────────────────────────────────────────────────────────

## Builds a 2D point.
pub function point_new(x: int = 0, y: int = 0) -> Point
    return Point { x: x, y: y }
end

## Builds 2D dimensions, clamping negatives to zero.
pub function size_new(w: int = 0, h: int = 0) -> Size
    let cw = w
    let ch = h
    if cw < 0
        cw = 0
    end
    if ch < 0
        ch = 0
    end
    return Size { w: cw, h: ch }
end

## Builds a rectangle from origin plus dimensions.
pub function rect_new(x: int = 0, y: int = 0, w: int = 0, h: int = 0) -> Rect
    return Rect { x: x, y: y, w: w, h: h }
end

## Builds an opaque RGB color (`a = 255`).
pub function color_rgb(r: int, g: int, b: int) -> Color
    return Color { r: r, g: g, b: b, a: 255 }
end

## Builds an RGBA color.
pub function color_rgba(r: int, g: int, b: int, a: int = 255) -> Color
    return Color { r: r, g: g, b: b, a: a }
end

## Builds a window configuration with validated dimensions.
##
## Non-positive dimensions fall back to `640x480`.
pub function window_config_new(title: string = "Alya", width: int = 640, height: int = 480) -> WindowConfig
    let w = width
    let h = height
    if w <= 0 or h <= 0
        w = 640
        h = 480
    end
    let t = title
    if t is null or t == ""
        t = "Alya"
    end
    return WindowConfig { title: t, width: w, height: h }
end

## Builds an event record with zeroed payload slots.
pub function event_new(kind: int = 0, x: int = 0, y: int = 0, key: int = 0, text: string = "", w: int = 0, h: int = 0) -> GuiEvent
    return GuiEvent { kind: kind, x: x, y: y, key: key, text: text, w: w, h: h }
end

# ───────────────────────────────────────────────────────────────
# Struct Methods
# ───────────────────────────────────────────────────────────────

## Returns the pixel area (`w * h`), or `0` for empty rects.
pub function Rect.area(self: Rect) -> int
    if self.w <= 0 or self.h <= 0
        return 0
    end
    return self.w * self.h
end

## Returns 1 when the rect is empty (`w <= 0` or `h <= 0`).
pub function Rect.is_empty(self: Rect) -> int
    if self.w <= 0 or self.h <= 0
        return 1
    end
    return 0
end

## Returns 1 when the point lies inside the rect (edges inclusive, empty never contains).
pub function Rect.contains(self: Rect, x: int, y: int) -> int
    if self.is_empty() == 1
        return 0
    end
    if x < self.x or y < self.y
        return 0
    end
    if x > self.x + self.w or y > self.y + self.h
        return 0
    end
    return 1
end

## Returns the pixel area (`w * h`), or `0` for empty sizes.
pub function Size.area(self: Size) -> int
    if self.w <= 0 or self.h <= 0
        return 0
    end
    return self.w * self.h
end

## Returns `"rgba(r, g, b, a)"` for logging and snapshot tests.
pub function Color.to_string(self: Color) -> string
    return "rgba(" + str(self.r) + ", " + str(self.g) + ", " + str(self.b) + ", " + str(self.a) + ")"
end
